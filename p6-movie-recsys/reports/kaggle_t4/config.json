{
  "name": "ml1m",
  "output_dir": "/kaggle/working/outputs/ml1m",
  "seeds": [
    0,
    1,
    2
  ],
  "models": [
    "popularity",
    "bpr_mf",
    "two_tower",
    "two_tower_nofeat",
    "two_tower_nologq",
    "two_tower_inbatch"
  ],
  "serve_model": "two_tower",
  "data": {
    "raw_dir": "data/raw",
    "url": "https://files.grouplens.org/datasets/movielens/ml-1m.zip",
    "min_rating": 4,
    "val_frac": 0.1,
    "test_frac": 0.1,
    "synthetic": false,
    "synthetic_users": 300,
    "synthetic_items": 120
  },
  "train": {
    "epochs": 40,
    "batch_size": 1024,
    "patience": 4,
    "device": "auto"
  },
  "bpr": {
    "dim": 64,
    "lr": 0.005,
    "reg": 1e-05
  },
  "tower": {
    "dim": 64,
    "emb": 32,
    "hidden": 128,
    "history_len": 30,
    "temperature": 0.05,
    "n_random_neg": 256,
    "logq": true,
    "use_features": true,
    "id_dropout": 0.1,
    "lr": 0.001,
    "weight_decay": 1e-06
  },
  "eval": {
    "ks": [
      10,
      20,
      50
    ],
    "k_main": 20,
    "n_bootstrap": 1000,
    "hnsw_m": 32,
    "hnsw_ef": [
      16,
      32,
      64,
      128
    ],
    "n_latency_queries": 1000,
    "n_examples": 5
  }
}